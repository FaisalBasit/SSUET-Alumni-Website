@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Adjust based on your layout path
    ViewData["Title"] = "SSUET Alumni - Events";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Sintony:wght@700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/styles.css">
</head>
<body>
    <!-- Navbar -->
    <nav id="navbar">
        <!-- Top Navbar Section -->
        <div id="top" class="top-navbar">
            <div class="social-links">
                <a href="https://www.linkedin.com/school/ssuetofficial/posts/?feedView=all" target="_blank"><img src="/Images/linkedin.png" alt="LinkedIn"></a>
                <a href="https://twitter.com/SSUET_Official/status/1760228797591208388" target="_blank"><img src="/Images/twitter.png" alt="Twitter"></a>
                <a href="https://www.facebook.com/ssuetians/" target="_blank"><img src="/Images/facebook.png" alt="Facebook"></a>
                <a href="https://www.instagram.com/sirsyeduniversityofficial/?hl=en" target="_blank"><img src="/Images/instagram.png" alt="Instagram"></a>
            </div>
            <div class="top-links">
                <a href="@Url.Action("Login", "Home")" class="desktop-link">My SSUET Online Log-in</a>
                <a href="@Url.Action("Login", "Home")" class="mobile-link">Log-in</a>
                <a href="#">FAQ</a>
                <a href="https://www.ssuet.edu.pk/">ssuet.edu.pk</a>
                <a asp-controller="Home" asp-action="Logout"><img src="/Images/logout.png" alt="Log Out"></a>
            </div>
        </div>

        <!-- Main Navbar Section -->
        <div class="main-navbar">
            <div class="logo">
                <a href="@Url.Action("Index", "Home")"><img src="/Images/f3-01.png" alt="SSUET Logo"></a>
            </div>
            <!-- Search Bar and Hamburger Menu -->
            <div class="search-bar">
                <input type="text" placeholder="Search...">
                <div class="hamburger" onclick="toggleMenu()">
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            </div>
            <ul class="nav-links">
                <li><a href=@Url.Action("News", "Home")>Quad News</a></li>
                <li><a href="@Url.Action("MySSUET", "Home")">My SSUET</a></li>
                <li><a href="@Url.Action("NewAlumni", "Home")">New Alumni</a></li>
                <li><a href="@Url.Action("Events", "Home")">Events</a></li>
                <li><a href="@Url.Action("AlumniGroup", "Home")">Alumni Groups</a></li>
                <li><a href="@Url.Action("Engage", "Home")">Engage</a></li>
            </ul>
        </div>
    </nav>


    <!-- Header Image -->
    <div class="header-image">
        <img src="~/Images/events2-02.png" alt="Events Header">
    </div>

    <section class="events-section">
        <!-- Upcoming Events -->
        <h1 class="events-title">Upcoming Events</h1>
        <div class="events-grid">
            <!-- Event 1 -->
            <div class="event-card upcoming">
                <div class="event-image">
                    <img src="~/Images/e1.jpg" alt="Tech Conference 2024">
                </div>
                <div class="event-details">
                    <h2>Tech Conference 2024</h2>
                    <p class="event-date">March 12, 2025</p>
                    <p class="event-description">
                        Explore groundbreaking technology trends and innovations during Tech Conference 2025, an event showcasing the latest advancements in the industry.
                    </p>
                    <a href="#" class="event-button">Learn More</a>
                </div>
            </div>

            <!-- Event 2 -->
            <div class="event-card upcoming">
                <div class="event-image">
                    <img src="~/Images/se (1).png" alt="Startup Expo">
                </div>
                <div class="event-details">
                    <h2>Startup Expo</h2>
                    <p class="event-date">August 30, 2025</p>
                    <p class="event-description">
                        Meet aspiring entrepreneurs at this expo designed to provide a platform for showcasing innovative startups and groundbreaking business ideas.
                    </p>
                    <a href="#" class="event-button">Learn More</a>
                </div>
            </div>

            <!-- Event 3 -->
            <div class="event-card upcoming">
                <div class="event-image">
                    <img src="~/Images/smec.jpg" alt="Smec">
                </div>
                <div class="event-details">
                    <h2>SMEC’25</h2>
                    <p class="event-date">January 22, 2025</p>
                    <p class="event-description">
                        Speed Mind Execution Competition (SMEC’25) will be held to provide an opportunity for young and talented students to showcase their soft skills in a more challenging manner.
                    </p>
                    <a href="#" class="event-button">Learn More</a>
                </div>
            </div>
        </div>

        <!-- Events Held Before -->
        <h1 class="events-title">Events Held Before</h1>
        <div class="events-grid">
            <!-- Event 1 -->
            <div class="event-card held">
                <div class="event-image">
                    <img src="~/Images/at.png" alt="Alumni Talk 2024">
                </div>
                <div class="event-details">
                    <h2>Alumni Talk 2024</h2>
                    <p class="event-date">August 15, 2024</p>
                    <p class="event-description">
                        SSUET's Alumni Talk was a great success! Thanks to our alumni for sharing their insights and bridging academics with the tech industry.
                    </p>
                    <a href="#" class="event-button">View Highlights</a>
                </div>
            </div>

            <!-- Event 2 -->
            <div class="event-card held">
                <div class="event-image">
                    <img src="~/Images/mhd.png" alt="Mental Health Day Camp">
                </div>
                <div class="event-details">
                    <h2>Mental Health Day Camp</h2>
                    <p class="event-date">July 10, 2023</p>
                    <p class="event-description">
                        The Department of Psychology organized a successful Mental Health Day Camp, offering workshops, counseling, and stress management activities to promote mental well-being.
                    </p>
                    <a href="#" class="event-button">View Highlights</a>
                </div>
            </div>

            <!-- Event 3 -->
            <div class="event-card held">
                <div class="event-image">
                    <img src="~/Images/ww.png" alt="Cultural Day 2023">
                </div>
                <div class="event-details">
                    <h2>Alumni Insights: Civil Engineering Batch 2014</h2>
                    <p class="event-date">June 5, 2023</p>
                    <p class="event-description">
                        Thanks to Zulqarnain Haider and Ikram Arif for sharing their inspiring career insights. Special thanks to Sir Siraj Khilji for his support.
                    </p>
                    <a href="#" class="event-button">View Highlights</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-about">
                <h4>About SSUET Alumni</h4>
                <p>A platform to connect, collaborate, and celebrate the achievements of Sir Syed University of Engineering and Technology alumni.</p>
            </div>
            <div class="footer-links">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                    <li><a href="@Url.Action("Events", "Home")">Events</a></li>
                    <li><a href="@Url.Action("Membership", "Home")">Membership</a></li>
                    <li><a href="@Url.Action("Contact", "Home")">Contact Us</a></li>
                </ul>
            </div>
            <div class="footer-contact">
                <h4>Contact Us</h4>
                <p>Email: <a href="mailto:alumni@ssuet.edu.pk">alumni@ssuet.edu.pk</a></p>
                <p>Phone: +92-21-12345678</p>
                <p>Address: SSUET, Karachi, Pakistan</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year SSUET Alumni. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/javascript/script.js"></script>
</body>
</html>
